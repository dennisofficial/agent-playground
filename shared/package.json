{
  "name": "@workspace/shared",
  "version": "1.0.0",
  "description": "Cross-workspace code shared between backend and the admin web: DTOs, zod schemas, enums, and helpers.",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./src/index.ts",
        "default": "./dist/index.js"
      }
    },
    "./schemas": {
      "import": {
        "types": "./src/schemas/index.ts",
        "default": "./dist/schemas.mjs"
      },
      "require": {
        "types": "./src/schemas/index.ts",
        "default": "./dist/schemas.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pnpm tsup",
    "dev": "nodemon",
    "prepare": "pnpm build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@swc/core": "^1.15.32",
    "@types/node": "^25.6.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "reflect-metadata": "^0.2.2",
    "tsup": "^8.5.1",
    "typeorm": "^0.3.30",
    "typescript": "^6.0.3"
  }
}
