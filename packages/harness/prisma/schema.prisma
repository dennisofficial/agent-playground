// A SQLite UNIQUE index treats NULLs as distinct, which is what lets
// (threadId, contextSlot, contextKey, contextDigest) constrain `context-loaded` rows while leaving
// every other event kind unconstrained. https://www.sqlite.org/lang_createindex.html#uniqueidx

generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "esm"
  runtime      = "bun"
}

datasource db {
  provider = "sqlite"
}

model Thread {
  id              String   @id
  title           String?
  head            Int      @default(0)
  createdAt       String
  updatedAt       String
  parentThreadId  String?
  forkSeq         Int?
  forkMode        String?
  spawnerThreadId String?
  agentType       String?
  workspace       String?
  repo            String?
  modelRef        String?
  modelEffort     String?
  executionLocation String?
  parent          Thread?  @relation("ThreadFork", fields: [parentThreadId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  forks           Thread[] @relation("ThreadFork")
  spawner         Thread?  @relation("ThreadSupervision", fields: [spawnerThreadId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  spawned         Thread[] @relation("ThreadSupervision")
  events          Event[]
  turns           Turn[]

  @@index([updatedAt])
  @@index([parentThreadId])
  @@index([spawnerThreadId])
  @@index([workspace, updatedAt])
}

model Event {
  id          String  @id
  threadId    String
  seq         Int
  runId       String
  parentRunId String?
  depth       Int
  at          String
  type        String
  body        String
  contextSlot String?
  contextKey  String?
  contextDigest String?
  thread      Thread  @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, seq])
  @@unique([threadId, contextSlot, contextKey, contextDigest])
  @@index([threadId, type])
}

model Turn {
  runId            String @id
  threadId         String
  status           String
  providerId       String
  modelId          String
  steps            Int
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int
  cacheWriteTokens Int
  startedAt        String
  endedAt          String
  durationMs       Int
  thread           Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, startedAt])
}
