// A SQLite UNIQUE index treats NULLs as distinct, which is what lets
// (branchId, contextSlot, contextKey, contextDigest) constrain `context-loaded` rows while leaving
// every other event kind unconstrained. https://www.sqlite.org/lang_createindex.html#uniqueidx

generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "esm"
  runtime      = "bun"
}

datasource db {
  provider = "sqlite"
}

model Branch {
  id             String  @id
  title          String?
  head           Int     @default(0)
  createdAt      String
  updatedAt      String
  parentBranchId String?
  forkSeq        Int?
  forkMode       String?
  events         Event[]
  turns          Turn[]

  @@index([updatedAt])
  @@index([parentBranchId])
}

model Event {
  id          String  @id
  branchId    String
  seq         Int
  runId       String
  parentRunId String?
  depth       Int
  at          String
  type        String
  body        String
  contextSlot String?
  contextKey  String?
  contextDigest String?
  branch      Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, seq])
  @@unique([branchId, contextSlot, contextKey, contextDigest])
  @@index([branchId, type])
}

model Turn {
  runId            String @id
  branchId         String
  status           String
  providerId       String
  modelId          String
  steps            Int
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int
  cacheWriteTokens Int
  startedAt        String
  endedAt          String
  durationMs       Int
  branch           Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, startedAt])
}
