ANTHROPIC_API_KEY=
# Required once semantic memory is on (fact embeddings, text-embedding-3-small). Not needed for
# chat or working-memory persistence alone.
OPENAI_API_KEY=
# Optional — leave commented to use defaults (an empty value would override the default):
# CHAT_MODEL=claude-sonnet-4-6
# CHAT_TEMPERATURE=1
# CHAT_MAX_TOKENS=2048

# Optional LangSmith tracing — each bot turn becomes a visible gate→llm⇄tools node graph. LangChain
# reads these from the env automatically; leave unset to disable (no tracing, no extra cost).
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=agent-playground
