{
  "name": "atlas",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "bun run --filter @dltech/atlas-harness db:ensure",
    "typecheck": "turbo run typecheck",
    "perf:report": "bun packages/harness/scripts/perf-report.ts",
    "proto:shell": "bun apps/tui/prototype/shell.tsx",
    "proto:round2": "bun apps/tui/prototype/round2.tsx",
    "proto:footer": "bun apps/tui/prototype/footer-pills.tsx",
    "proto:attachments": "bun apps/tui/prototype/user-attachments.tsx",
    "test": "turbo run test",
    "build": "turbo run build"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.71.0",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "turbo": "^2.10.11",
    "typescript": "6.0.3"
  },
  "dependencies": {},
  "overrides": {
    "typescript": "6.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@types/react": "^19",
    "@types/react-dom": "^19"
  }
}
