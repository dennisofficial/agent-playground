# Keep the GENERIC workspace base-image build context (repo root) lean. The base image bakes NO repo
# code (it only COPYs backend/src/daemon/entrypoint.sh) — the daemon is built separately into a volume
# by `pnpm daemon:build` (a `docker run` bind-mount, to which this .dockerignore does NOT apply). So
# these excludes just stop host node_modules / build output / caches from bloating the build context.

# Dependencies (reinstalled in-image from the lockfile)
**/node_modules

# Build output (recompiled in-image)
**/dist
backend/dist
shared/dist
packages/**/dist
web/.next

# Git internals (submodules are checked out as working trees and DO get copied)
.git
**/.git

# Agent-runtime scratch (host-local; recreated per sandbox)
.agent-home
**/.agent-home
.workspaces
**/.workspaces
.worktrees
**/.worktrees

# Local env + secrets. Encrypted .env.*.enc files are ciphertext (safe to bake into the image — the
# runtime image only decrypts them given the matching DOTENV_PRIVATE_KEY_*_ENC at container start).
# Plaintext env files and the private .env.keys store are never baked.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.enc
**/.env.keys

# Editor / OS noise
**/.DS_Store
**/*.log
**/coverage
**/.turbo
**/.vitest
