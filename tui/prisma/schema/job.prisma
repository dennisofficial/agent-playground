// A job's phase kinds. The pipeline graph (which phase may follow which) is an affordance that
// lives in code beside the role bindings, not a constraint in the schema — every edge is legal.
enum EPhaseKind {
  /// Every job's first phase, and the only kind that names an ABSENCE rather than an activity — a
  /// reader seeing it correctly infers that nothing has been decided about this job yet. A generic
  /// coding agent: it answers questions and makes changes in the conversation, and proposes the
  /// pipeline only when the work turns out to need a document to survive. Nothing points at it;
  /// re-entry is the human's start-a-phase verb.
  generic
  charting
  design
  planning
  build
  direct_build
  master_review
  post_build
  ci
}

model Job {
  id             String    @id @default(uuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  activeThreadId String?
  /// Archive is a pure hide, so it stores WHEN rather than a status: it composes with everything
  /// else a row renders instead of excluding it, and restoring is clearing a timestamp.
  archivedAt     DateTime?
  /// A job may take its own branch and its own worktree so Atlas never checks a branch out from
  /// under the editor Dennis has open on the project path. Both null = the job works in the
  /// project path exactly as before; the worktree is optional, not the default.
  branch         String?
  workspacePath  String?
  /// A RENDER CACHE, not a parse — `shipped` honestly means "a PR exists". Non-terminal: a shipped
  /// job going back to active on the next phase is correct. There is no second field synced off
  /// GitHub, because locally it would have no writer.
  prNumber       Int?
  transitions    Transition[]
  phases         Phase[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// One phase instance of a job. `kind` IS the phase; phases are appended, never reordered, so the
/// highest ordinal is the job's current phase.
model Phase {
  id      String     @id @default(uuid())
  jobId   String
  job     Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind    EPhaseKind
  title   String?
  ordinal Int
  threads Thread[]

  @@unique([jobId, ordinal])
}
