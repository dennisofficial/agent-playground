#!/usr/bin/env bash
# Capture a screenshot from a running iOS simulator via `xcrun simctl`.
# Prints the absolute path of the saved PNG on success so it can be piped to viewers / the Read tool.

set -euo pipefail

device="booted"
format="png"
out=""
to_stdout=0

usage() {
  cat <<EOF
Usage: ios-screenshot [--device <udid|name|booted>] [--format <png|jpeg|tiff|bmp|gif>] [--out <path>] [--stdout]

Defaults:
  --device booted
  --format png
  output:  ./.screenshots/ios-sim-<ISO8601-timestamp>.<ext>

Examples:
  ios-screenshot
  ios-screenshot --out /tmp/foo.png
  ios-screenshot --device "iPhone 17 Pro Max"
  ios-screenshot --format jpeg --out /tmp/foo.jpg
  ios-screenshot --stdout > shot.png
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --device) device="$2"; shift 2 ;;
    --format) format="$2"; shift 2 ;;
    --out)    out="$2"; shift 2 ;;
    --stdout) to_stdout=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

if [[ $to_stdout -eq 1 && -n "$out" ]]; then
  echo "Error: --stdout and --out are mutually exclusive." >&2
  exit 2
fi

case "$format" in
  png|jpeg|tiff|bmp|gif) : ;;
  *) echo "Error: unsupported --format '$format' (allowed: png, jpeg, tiff, bmp, gif)" >&2; exit 2 ;;
esac

# Pre-flight: confirm a booted device exists when the caller relied on the default.
if [[ "$device" == "booted" ]]; then
  booted_list=$(xcrun simctl list devices booted 2>&1 || true)
  if ! grep -q "(Booted)" <<<"$booted_list"; then
    echo "Error: no iOS simulator is booted." >&2
    echo "" >&2
    echo "Boot one from Xcode > Open Developer Tool > Simulator, or:" >&2
    echo "  xcrun simctl boot \"<device name or UDID>\"" >&2
    echo "" >&2
    echo "Currently booted devices:" >&2
    echo "$booted_list" >&2
    exit 1
  fi
fi

if [[ $to_stdout -eq 1 ]]; then
  exec xcrun simctl io "$device" screenshot --type="$format" -
fi

# Resolve output path.
if [[ -z "$out" ]]; then
  ts=$(date +"%Y-%m-%dT%H-%M-%S")
  mkdir -p .screenshots
  out=".screenshots/ios-sim-${ts}.${format}"
fi

xcrun simctl io "$device" screenshot --type="$format" "$out" >/dev/null 2>&1 || {
  # Re-run without redirecting to surface simctl's error to the user.
  xcrun simctl io "$device" screenshot --type="$format" "$out"
  exit 1
}

# Print the absolute path on a single line for easy piping.
if command -v realpath >/dev/null 2>&1; then
  realpath "$out"
else
  python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "$out"
fi
