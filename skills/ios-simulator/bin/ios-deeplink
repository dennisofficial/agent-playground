#!/usr/bin/env bash
# Open a deep link URL in a running iOS simulator via `xcrun simctl openurl`.
# Useful for navigating directly to a specific screen without tapping through the UI.

set -euo pipefail

device="booted"

usage() {
  cat <<EOF
Usage: ios-deeplink <url> [--device <udid|name|booted>]

Arguments:
  url     The deep link URL to open (e.g. myapp://settings/notifications)

Options:
  --device  Simulator UDID or name (default: booted)

Examples:
  ios-deeplink myapp://home
  ios-deeplink "myapp://profile/42?tab=posts"
  ios-deeplink myapp://onboarding/step/3 --device "iPhone 17 Pro Max"

Notes:
  - The URL scheme must be registered in the app's Info.plist (CFBundleURLSchemes).
  - Universal links (https://) also work if the app is installed and handles them.
  - Use ios-screenshot immediately after to verify the correct screen opened.
EOF
}

if [[ $# -eq 0 ]]; then
  usage
  exit 2
fi

url=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --device) device="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
    *)
      if [[ -n "$url" ]]; then
        echo "Error: unexpected argument '$1' (URL already set to '$url')" >&2; exit 2
      fi
      url="$1"; shift ;;
  esac
done

if [[ -z "$url" ]]; then
  echo "Error: a URL is required." >&2
  usage >&2
  exit 2
fi

# Pre-flight: confirm a booted device exists when relying on the default.
if [[ "$device" == "booted" ]]; then
  booted_list=$(xcrun simctl list devices booted 2>&1 || true)
  if ! grep -q "(Booted)" <<<"$booted_list"; then
    echo "Error: no iOS simulator is booted." >&2
    echo "" >&2
    echo "Boot one with: xcrun simctl boot \"<device name or UDID>\"" >&2
    echo "" >&2
    echo "Currently booted devices:" >&2
    echo "$booted_list" >&2
    exit 1
  fi
fi

xcrun simctl openurl "$device" "$url"
echo "Opened: $url"
