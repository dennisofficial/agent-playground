{
  "name": "@workspace/codex-sdk",
  "version": "0.1.0",
  "description": "Standalone, Atlas-agnostic TypeScript SDK for OpenAI Codex, built on the `codex app-server` JSON-RPC protocol: typed thread/turn API, mid-turn steer, per-call approval interception, and a rich typed event stream.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./src/index.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pnpm tsup",
    "dev": "nodemon",
    "prepare": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "codex",
    "openai",
    "app-server",
    "json-rpc",
    "sdk"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@swc/core": "^1.15.32",
    "@types/node": "^25.6.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  }
}
