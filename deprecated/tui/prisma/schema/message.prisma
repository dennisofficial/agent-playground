/// One flat enum with an exhaustive type → render map, so a new member fails to compile at the
/// renderer rather than silently rendering as nothing.
enum EMessageType {
  user
  assistant
  thinking
  tool_call
  tool_result
  error
  /// Anything the harness injects into a session — a phase brief, a rotation handoff, a delegate's
  /// report, a context nudge. Its *variant* lives in the payload rather than here, so this enum
  /// stays small and the renderer switches on variant. Dennis's own words are `user` and go in
  /// bare: if everything were tagged, the tags would signal nothing.
  harness
}

model ThreadMessage {
  id        String        @id @default(uuid())
  threadId  String
  thread    Thread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sessionId String
  session   EngineSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ordinal   Int
  type      EMessageType
  /// Normalised shape from domain/message.ts, never raw SDK output.
  payload   Json
  createdAt DateTime      @default(now())

  @@unique([threadId, ordinal])
  @@index([sessionId])
}
