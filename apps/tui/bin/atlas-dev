#!/usr/bin/env sh
set -eu

# Bun resolves its tsconfig from the process working directory, so a source launch has to start
# inside this workspace or it loses `emitDecoratorMetadata` and every injected constructor with it.
# The directory to work in travels as --cwd instead.
# https://bun.com/docs/runtime/typescript

self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done

tui=$(cd "$(dirname "$self")/.." && pwd)
project=$PWD

cd "$tui"

quietly() {
  if ! output=$("$@" 2>&1); then
    printf '%s\n' "$output" >&2
    printf 'atlas-dev: %s failed; the launch would have read a stale manifest\n' "$*" >&2
    exit 1
  fi
}

generate() {
  if [ "${ATLAS_DEV_SKIP_GENERATE:-}" = "" ]; then
    quietly bun run --filter @dltech/atlas-harness db:ensure
    quietly bun scripts/generate-manifest.ts
    quietly bun scripts/generate-skills.ts
    quietly bun scripts/generate-plugins.ts
  fi
}

# /restart inside the TUI writes the conversation to resume into this file and exits 75; anything
# else — ctrl+c included — passes straight through.
RESTART=75

restart_file=$(mktemp "${TMPDIR:-/tmp}/atlas-dev-restart.XXXXXX")
trap 'rm -f "$restart_file"' EXIT
export ATLAS_DEV_RESTART_FILE="$restart_file"
export ATLAS_DEV=1

generate

# Every source launch profiles itself at Bun's default 1 ms sampling interval: cheap enough that
# the PerfSample telemetry can measure the overhead, and every exit leaves a flamegraph so a hot
# session explains itself after the fact. Profiles live in the Atlas home rather than beside the
# checkout — a worktree launch would otherwise scatter them somewhere that gets deleted, and the
# PerfSample rows they pair with are in the same place. ATLAS_CPU_PROF=0 opts out.
PROF_ARGS=""
if [ "${ATLAS_CPU_PROF:-1}" != "0" ]; then
  prof_dir="${ATLAS_HOME:-$HOME/.atlas}/cpuprofiles"
  mkdir -p "$prof_dir"
  PROF_ARGS="--cpu-prof --cpu-prof-dir=$prof_dir --cpu-prof-name=atlas-$(date +%Y%m%d-%H%M%S)-$$.cpuprofile"
fi

while :; do
  code=0
  bun $PROF_ARGS src/main.tsx --cwd "$project" "$@" || code=$?

  if [ "$code" -ne "$RESTART" ]; then
    exit "$code"
  fi

  handle=$(cat "$restart_file")
  : > "$restart_file"

  printf 'atlas-dev: rebuilding and restarting\n' >&2
  generate

  if [ -n "$handle" ]; then
    set -- --resume "$handle"
  else
    set --
  fi
done
