# Atlas production Caddyfile.
# Auto-HTTPS via Let's Encrypt. Caddy handles certificate provisioning automatically.
#
# TODO: replace the placeholder email with a real contact address for LE notifications.

{
    email admin@dltechnologies.co  # TODO: replace with a real email for Let's Encrypt
