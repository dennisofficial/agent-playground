# /srv/atlas/secrets/atlas.env — production secrets template.
#
# Copy this file to /srv/atlas/secrets/atlas.env on the production box.
# Set mode 600: chmod 600 /srv/atlas/secrets/atlas.env
# This file is read by docker-compose.prod.yml via `env_file`.
#
# House style: dotenvx (.env.*.enc) is for committed encrypted files in the repo.
# This file is the plain-text runtime secret store on the box — it is NEVER committed.
# The DOTENV_PRIVATE_KEY* values here decrypt the per-package .env.*.enc files if you
# run any backend CLI commands on the box (e.g. pnpm db:migrate). They are optional at
# runtime since the backend in prod reads env vars directly (no dotenvx wrapper in prod).
#
# ── dotenvx private keys (optional — needed only for CLI decrypt on the box) ────
# DOTENV_PRIVATE_KEY_LOCAL_ENC=CHANGEME          # decrypts backend/.env.local.enc
# DOTENV_PRIVATE_KEY_PRODUCTION_ENC=CHANGEME     # decrypts backend/.env.production.enc (if present)

# ── System ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_ENV=production

# ── Postgres ─────────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres          # resolved via the atlas compose network
POSTGRES_PORT=5432
POSTGRES_USER=atlas
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=atlas_production
POSTGRES_SSL_MODE=disable       # internal compose network — no TLS needed between containers
# POSTGRES_POOL_MAX=20          # optional, default 10

# ── Redis ─────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379    # resolved via the atlas compose network
# Redis is the sole engine transport (ADR 0001). The per-thread sandbox reaches Redis over the internal
# `atlas-bus` network — SANDBOX_REDIS_URL + SANDBOX_BUS_NETWORK are set in docker-compose.prod.yml (infra,
# not secrets), so they don't belong here. (Dev sets SANDBOX_REDIS_URL=redis://host.docker.internal:6380.)

# ── JWT auth (Atlas web console) ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=CHANGEME
JWT_REFRESH_SECRET=CHANGEME
# COOKIE_DOMAIN=.dltechnologies.co   # set to scope cookies across subdomains
# ADMIN_SEED_EMAIL=admin@example.com # seeds an admin account on first boot
# ADMIN_SEED_PASSWORD=CHANGEME

# ── Secrets encryption (per-org AES-256-GCM store) ───────────────────────────────
# Generate with: openssl rand -hex 32
SECRETS_ENCRYPTION_KEY=CHANGEME

# ── GitHub (webhook verification + PR operations) ────────────────────────────────
GITHUB_TOKEN=CHANGEME            # PAT with repo + workflow scope
GITHUB_WEBHOOK_SECRET=CHANGEME   # must match the secret set in the GitHub webhook config
# WEBHOOK_SECRET=CHANGEME        # for the generic /ingress/webhook endpoint (optional)

# ── LLM providers ────────────────────────────────────────────────────────────────
# Set at least one. Per-org keys can also be added via the web onboarding UI and are
# stored encrypted in the DB (org_credentials table).
ANTHROPIC_API_KEY=CHANGEME
# OPENAI_API_KEY=CHANGEME         # optional — needed for pgvector semantic memory embeddings
# CLAUDE_OAUTH_TOKEN=CHANGEME     # Claude subscription OAuth token (alternative to API key)
# CODEX_OAUTH_TOKEN=CHANGEME      # Codex subscription token

# ── CORS ─────────────────────────────────────────────────────────────────────────
FRONTEND_HOST=https://atlas.dltechnologies.co

# ── Backend HTTP ──────────────────────────────────────────────────────────────────
HTTP_PORT=4002
# BACKEND_HOST=https://api.atlas.dltechnologies.co   # used for self-referential URLs

# ── Docker sandbox layer ─────────────────────────────────────────────────────────
# These are set via `environment:` in docker-compose.prod.yml but can be overridden here.
DOCKER_SOCKET_PATH=/var/run/docker.sock
SANDBOX_IMAGE=atlas-sandbox:latest
# SANDBOX_REBUILD=1              # uncomment to force sandbox image rebuild on next boot
# MAX_CONCURRENT_SANDBOXES=4     # optional cap on simultaneous sandboxes

# ── Data roots (same-path bind mount /srv/atlas/data:/srv/atlas/data) ────────────
# These match the docker-compose.prod.yml `environment:` block.
# Override here only if you need a different path layout.
REPOS_ROOT=/srv/atlas/data/repos
AGENT_HOME_ROOT=/srv/atlas/data/agent-home
REFS_ROOT=/srv/atlas/data/refs
ATLAS_GOLDEN_ROOT=/srv/atlas/data/golden
ENGINE_BUNDLE_PATH=/srv/atlas/data/engine/engine-entrypoint.mjs

# ── Clustering / rolling-update ──────────────────────────────────────────────────
LEADER_POLL_INTERVAL_MS=2000    # how often a follower polls for the advisory lock (ms)
DRAIN_GRACE_MS=120000           # max time to drain in-flight turns before force-exit (ms)
                                # docker-compose stop_grace_period (300s) must exceed this
REALTIME_SLOT_PREFIX=pg_realtime_slot

# ── Observability (optional) ──────────────────────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=CHANGEME
# LANGFUSE_SECRET_KEY=CHANGEME
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=production

# ── Build driver tuning (optional — code defaults are sane) ──────────────────────
# MAX_SECTIONS=12
# MAX_PHASES_PER_SECTION=8
# MAX_PHASES_PER_BATCH=5
# PHASE_TIMEOUT_MS=1200000    # 20 min per engine turn
# JOB_TIMEOUT_MS=3600000      # 60 min per job
