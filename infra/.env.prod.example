# /srv/atlas/secrets/atlas.env — production secrets template.
#
# Copy this file to /srv/atlas/secrets/atlas.env on the production box.
# Set mode 600: chmod 600 /srv/atlas/secrets/atlas.env
# This file is read by docker-compose.prod.yml via `env_file`.
#
# House style: dotenvx (.env.*.enc) is for committed encrypted files in the repo.
# backend/.env.production.enc holds the real secret values (POSTGRES_PASSWORD,
# JWT_*_SECRET, SECRETS_ENCRYPTION_KEY, GITHUB_WEBHOOK_SECRET) as committed ciphertext,
# baked into the backend/migrator images. This file — the plain-text runtime store on
# the box, NEVER committed — only needs to hold the ONE key that decrypts it.
#
# DO NOT add POSTGRES_USER/PASSWORD/DB here. This file is the backend's compose
# `env_file:`, so anything in it is injected into the backend container and would SHADOW
# the values dotenvx decrypts from .env.production.enc (the entrypoint's `dotenvx run`
# has no `-o`). Postgres bootstrap creds live in /srv/atlas/.env — see infra/.env.compose.example.

# ── dotenvx private key (required — decrypts backend/.env.production.enc) ───────
DOTENV_PRIVATE_KEY_PRODUCTION_ENC=CHANGEME   # from backend/.env.keys, never commit that file

# ── System ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_ENV=production

# ── GitHub (Atlas's own git/PR ops — optional, per-repo PATs from onboarding are the
# normal path; this is only a global dev-convenience fallback) ──────────────────
# GITHUB_TOKEN=CHANGEME            # PAT with repo + workflow scope
# WEBHOOK_SECRET=CHANGEME          # for the generic /ingress/webhook endpoint (optional)

# ── LLM providers (optional — per-org keys from the web onboarding UI are the normal
# path, stored encrypted in org_credentials; this is only a global dev-convenience
# fallback, same pattern as GITHUB_TOKEN above) ──────────────────────────────────
# ANTHROPIC_API_KEY=CHANGEME
# OPENAI_API_KEY=CHANGEME         # optional — needed for pgvector semantic memory embeddings
# CLAUDE_OAUTH_TOKEN=CHANGEME     # Claude subscription OAuth token (alternative to API key)
# CODEX_OAUTH_TOKEN=CHANGEME      # Codex subscription token

# ── COOKIE_DOMAIN / admin seed (optional) ────────────────────────────────────────
# COOKIE_DOMAIN=.byatlas.io   # optional; leave unset for host-only cookies (app↔api share via SameSite=Lax)
# ADMIN_SEED_EMAIL=admin@example.com # seeds an admin account on first boot
# ADMIN_SEED_PASSWORD=CHANGEME

# ── Sandbox preview exposures — Cloudflare DNS-01 wildcard cert ───────────────────
# Read by the Caddy container (docker-compose.prod.yml `caddy` service) to issue the ONE
# `*.preview.byatlas.io` wildcard TLS cert via the ACME DNS-01 challenge. Scoped
# Cloudflare API *token* (not the global key): Zone:Read + DNS:Edit on the byatlas.io
# zone. Pair with the one-time `*.preview.byatlas.io` A record (see infra/README.md).
# CLOUDFLARE_API_TOKEN=CHANGEME

# ── CORS ─────────────────────────────────────────────────────────────────────────
FRONTEND_HOST=https://app.byatlas.io

# ── Backend HTTP ──────────────────────────────────────────────────────────────────
HTTP_PORT=4002
# This backend's own public origin — used for self-referential URLs, notably the MCP OAuth redirect_uri
# (${BACKEND_HOST}/web/mcp/oauth/callback). Set in docker-compose.prod.yml; override here if needed. MUST be the
# https backend host, not the web origin — else OAuth consent registers a dead http://localhost:4000 redirect.
BACKEND_HOST=https://api.byatlas.io

# ── Docker sandbox layer ─────────────────────────────────────────────────────────
# These are set via `environment:` in docker-compose.prod.yml but can be overridden here.
DOCKER_SOCKET_PATH=/var/run/docker.sock
SANDBOX_IMAGE=atlas-sandbox:latest
# MAX_CONCURRENT_SANDBOXES=4     # optional cap on simultaneous sandboxes
# Best-effort CPU for sandboxes: relative weight (Docker CpuShares → cgroup v2 cpu.weight) on every
# per-job sandbox so bursty agent compute yields to the host control plane under contention. Control
# plane keeps the default 1024; sandboxes 256 (≈4:1). Bites only under contention — an idle box lets a
# sandbox use 100% of the CPU (no cap). Unset ⇒ Docker default / no isolation. Range 2–262144; lower =
# yields harder. Set in docker-compose.prod.yml; override here if needed.
SANDBOX_CPU_SHARES=256

# ── Data roots (same-path bind mount /srv/atlas/data:/srv/atlas/data) ────────────
# These match the docker-compose.prod.yml `environment:` block.
# Override here only if you need a different path layout.
REPOS_ROOT=/srv/atlas/data/repos
AGENT_HOME_ROOT=/srv/atlas/data/agent-home
REFS_ROOT=/srv/atlas/data/refs
SKILLS_ROOT=/srv/atlas/data/skills
ATLAS_GOLDEN_ROOT=/srv/atlas/data/golden
ENGINE_BUNDLE_PATH=/srv/atlas/data/engine/engine-entrypoint.mjs
# Codex MCP tool-bridge bundle — MUST be host-resolvable (under the same-path mount) since the sandbox
# manager bind-mounts it; without it, sandbox create fails with an OCI "not a directory" mount error.
MCP_BRIDGE_BUNDLE_PATH=/srv/atlas/data/engine/mcp-bridge-server.mjs
# Persistent per-sandbox MCP hub bundle — same host-resolvable requirement as the two paths above.
MCP_HUB_BUNDLE_PATH=/srv/atlas/data/engine/mcp-hub-server.mjs

# ── Clustering / rolling-update ──────────────────────────────────────────────────
# The leader-poll interval (2s), drain grace (120s), and realtime slot prefix are CODE CONSTANTS now,
# not env vars — docker-compose stop_grace_period (300s) must stay above the 120s drain grace.

# ── atlas-prod MCP DB roles (backend-hosted diagnostics reads + gated recovery writes) ───
# The backend connects two DEDICATED, least-privilege DB roles for the `atlas-prod` MCP — NEVER its own
# full-priv `app` connection. Only the USER + PASSWORD live here; host/port/DB reuse the POSTGRES_* above
# (the roles are on the SAME server + DB as the app). Bootstrap the roles with infra/mcp-reader-role.sql
# and infra/mcp-writer-role.sql (see infra/README.md §7.5). Leave unset in any repo that is not Atlas —
# unset fail-closes the feature (no dedicated pools, no write path).
#   MCP_READER_PG_USER=mcp_reader          # SELECT-only: all reads + the pre-approval EXPLAIN preview
#   MCP_READER_PG_PASSWORD=CHANGEME
#   MCP_WRITER_PG_USER=mcp_writer          # DML-only: runs ONLY an operator-approved recovery statement
#   MCP_WRITER_PG_PASSWORD=CHANGEME

# ── Observability (optional) ──────────────────────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=CHANGEME
# LANGFUSE_SECRET_KEY=CHANGEME
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=production

# NOTE: build-driver tuning (MAX_SECTIONS, PHASE_TIMEOUT_MS, etc.) and sandbox timings are code
# constants, not env vars — see the backend services for their values.
