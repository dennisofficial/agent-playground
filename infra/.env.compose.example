# /srv/atlas/.env — docker compose interpolation store (Postgres bootstrap).
#
# Copy this file to /srv/atlas/.env on the production box, fill in the values, and
# set mode 600: chmod 600 /srv/atlas/.env
#
# WHAT THIS IS FOR
# docker compose reads this file at PARSE TIME (deploy.sh runs every compose command
# with `--env-file /srv/atlas/.env`) to substitute ${POSTGRES_USER}/${POSTGRES_PASSWORD}/
# ${POSTGRES_DB} when it CREATES the `postgres` service (docker-compose.prod.yml). This
# has to be plaintext: compose provisions the database container before any container —
# let alone dotenvx — runs, so it can't read the encrypted backend/.env.production.enc.
# infra/backups/pg-backup.sh also sources this file for POSTGRES_USER/POSTGRES_DB.
#
# SOURCE OF TRUTH / SYNC
# The authoritative copy of these values is the committed, dotenvx-encrypted
# backend/.env.production.enc (which the backend + migrator decrypt in-container at
# startup). Keep the values here IN SYNC with that encrypted copy.
#
# DO NOT put these in /srv/atlas/secrets/atlas.env. That file is the backend's compose
# `env_file:`, so anything in it is injected into the backend container — and since the
# entrypoint's `dotenvx run` has no `-o`/`--overload`, it would SHADOW the values
# dotenvx decrypts from .env.production.enc. Postgres creds belong here, and only here.

POSTGRES_USER=CHANGEME
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=CHANGEME
