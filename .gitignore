node_modules
dist
*.log
.DS_Store

# Per-worker git workspaces (one full-repo checkout per execute job) — see playground/src/workspace.ts
.workspaces/

# Worker engines' isolated config/state homes (CLAUDE_CONFIG_DIR / CODEX_HOME) — runtime session
# transcripts + per-engine config, never committed. See backend/src/harness/engines/engine-home.ts
.agent-home/

# Atlas durable HOST-side runtime state, kept INSIDE the repo so the working set is self-contained
# (delete the checkout → state goes with it). Holds engine homes, repo clones/worktrees, and the
# hydration sidecar. Repo-relative defaults; override via AGENT_HOME_ROOT / REPOS_ROOT /
# ATLAS_HYDRATION_STATE for a persistent volume in deployment. See backend/src/app/state-root.ts
.atlas-state/

# Atlas agent thread scratch/metadata — host-side runtime, never part of the repo…
# …EXCEPT the durable decision ledger, which IS committed so future threads inherit it.
.atlas/*
!.atlas/decisions/

# dotenvx — encrypted .env.*.enc files ARE committed; keys / personal / plaintext-local are NOT
.env
.env.local
.env.personal
.env.keys
!.env.*.enc

# Cloud / build local dirs (gcloud ADC, docker context)
/.gcloud/
/.docker/
# Slack app credentials captured at app-creation time (apps.manifest.create) — NEVER commit
backend/slack-manifests/.app-credentials.json
.playwright-cli
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# design-sync staged scripts + isolated deps (never commit)
.ds-sync/
