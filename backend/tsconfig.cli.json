{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": ".",
    "noEmit": false,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0"
  },
  "include": ["cli/**/*", "migrations/**/*", "seeds/**/*"],
  "exclude": ["node_modules", "dist", "seeds/_deferred"]
}
