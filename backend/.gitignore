# compiled output
/dist
/node_modules
*.tsbuildinfo
/coverage

# legacy generated engine bundle (removed from the Docker path; ignored so stale local artifacts stay local)
engine-entrypoint.mjs
# generated Codex MCP tool-bridge server bundle (re-bundled on boot alongside the engine app)
mcp-bridge-server.mjs
# generated in-sandbox MCP hub bundle (re-bundled on boot alongside the engine app)
mcp-hub-server.mjs
# generated engine app bundle (nest build engine --webpack; baked at image-build time, regenerable via
# `pnpm -C backend build:engine`, mirrored live at boot by ensureEngineApp())
engine-app.js
engine-app.js.map

# logs
*.log

# dev-only restart-storm marker (dev-restart-guard.ts) — local boot-timestamp history, never shared
.dev-boot-log.json

# dotenvx — encrypted .env.*.enc files ARE committed; keys / personal / plaintext-local are NOT
.env
.env.local
.env.personal
.env.keys
!.env.*.enc

# GitHub App private key — operator-supplied secret, encrypted into .env.production.enc; raw PEM never committed
gh-app-private-key.pem

# OS / IDE
.DS_Store
