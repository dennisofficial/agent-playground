# compiled output
/dist
/node_modules
*.tsbuildinfo
/coverage

# generated engine bundle (the API rebundles it on boot into dist; the CLI can regenerate it in src)
engine-entrypoint.mjs
# generated Codex MCP tool-bridge server bundle (re-bundled on boot alongside the engine bundle)
mcp-bridge-server.mjs
# generated in-sandbox MCP hub bundle (re-bundled on boot alongside the engine bundle)
mcp-hub-server.mjs

# logs
*.log

# dev-only restart-storm marker (dev-restart-guard.ts) — local boot-timestamp history, never shared
.dev-boot-log.json

# dotenvx — encrypted .env.*.enc files ARE committed; keys / personal / plaintext-local are NOT
.env
.env.local
.env.personal
.env.keys
!.env.*.enc

# GitHub App private key — operator-supplied secret, encrypted into .env.production.enc; raw PEM never committed
gh-app-private-key.pem

# OS / IDE
.DS_Store
