# backend/.env.example — copy to .env.personal for per-developer overrides:
#   cp .env.example .env.personal
#
# Most local config (Postgres creds, SECRETS_ENCRYPTION_KEY, the Slack ears tokens, the puppet +
# tenant seeds, ADMIN_API_TOKEN, APPROVAL_BOSS_USER_ID) is SHARED and lives — encrypted — in the
# committed .env.local.enc. You do NOT need to set those here; you only need the private key to
# decrypt them. Get backend/.env.keys (DOTENV_PRIVATE_KEY_LOCAL_ENC) from 1Password and drop it
# in backend/. Then: `docker compose up -d postgres && pnpm install && pnpm db:recreate`.
#
# Anything you put in .env.personal OVERRIDES the shared .env.local.enc (dotenvx `-o`). Use it for
# personal secrets and machine-specific overrides only.

# Your own LLM keys (required to actually run the bots; not shared).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Absolute path to this repo on your machine (workspace root for worker sessions).
WORKER_ROOT=

# Optional: override the shared Slack dev workspace with your own (else inherit .env.local.enc).
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_PUPPET_SEED={"teamId":"T0...","tokens":{"alex":"xoxb-...","sam":"xoxb-..."}}
# SLACK_TENANT_SEED={"teamId":"T0...","botToken":"xoxb-...","installedBy":"U0..."}

# Optional: Langfuse tracing (leave unset to disable).
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=development

# --- Workspace sandboxes (REQUIRED to let the bots read/build code locally) ---
# Sandboxes are mandatory now (daemon-only): the first time a bot tries to read code it spawns a
# per-task DinD sandbox, and without these it dies with "WORKSPACE_IMAGE is not set". One-time setup:
#   docker compose up -d            # postgres + redis (redis on host :6380, service DNS on the compose net)
# The slack-app self-provisions the base image + daemon volume AT BOOT (WorkspaceProvisionerService), so
# `pnpm daemon:build` is now OPTIONAL — only run it to pre-build, or rebuild manually outside the app.
# See backend/README.md "Workspace sandboxes" and backend/src/daemon/__e2e__/sandbox-turn.e2e.ts (canonical recipe).
WORKSPACE_IMAGE=agent-workspace-base
# Boot self-provisioning knobs (all optional):
#   REPO_ROOT=/abs/path/to/agent-playground   # set ONLY if the slack-app runs in a container (host-path bind mount)
#   REBUILD_IMAGE=true                          # force a base-image rebuild even if it exists
#   SKIP_DAEMON_BUILD=true                      # skip the boot daemon rebuild, reuse the existing volume (fast restarts)
# Docker Desktop only: overlay-on-overlay can't mount, so force the inner dockerd to vfs. EMPTY on real Linux.
WORKSPACE_DOCKER_STORAGE_DRIVER=vfs
# The host harness ↔ sandbox bus. The host reaches the compose Redis at :6380; the default redis://127.0.0.1:6379
# is the wrong instance (the sandbox connects to the SAME Redis by service DNS, so both must be the compose one).
REDIS_URL=redis://localhost:6380
# WORKSPACE_REDIS_URL / WORKSPACE_NETWORK have correct compose defaults (agent-playground-redis:6379 /
# agent-playground_default) — only set them if you run a non-default compose project name or network.
