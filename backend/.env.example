# backend/.env.example — copy to .env.personal for per-developer overrides:
#   cp .env.example .env.personal
#
# Most local config (Postgres creds, SECRETS_ENCRYPTION_KEY, the Slack ears tokens, the puppet +
# tenant seeds, ADMIN_API_TOKEN, APPROVAL_BOSS_USER_ID) is SHARED and lives — encrypted — in the
# committed .env.local.enc. You do NOT need to set those here; you only need the private key to
# decrypt them. Get backend/.env.keys (DOTENV_PRIVATE_KEY_LOCAL_ENC) from 1Password and drop it
# in backend/. Then: `docker compose up -d postgres && pnpm install && pnpm db:recreate`.
#
# Anything you put in .env.personal OVERRIDES the shared .env.local.enc (dotenvx `-o`). Use it for
# personal secrets and machine-specific overrides only.

# Your own LLM keys (required to actually run the bots; not shared).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Absolute path to this repo on your machine (workspace root for worker sessions).
WORKER_ROOT=

# Optional: override the shared Slack dev workspace with your own (else inherit .env.local.enc).
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_PUPPET_SEED={"teamId":"T0...","tokens":{"alex":"xoxb-...","sam":"xoxb-..."}}
# SLACK_TENANT_SEED={"teamId":"T0...","botToken":"xoxb-...","installedBy":"U0..."}

# Optional: Langfuse tracing (leave unset to disable).
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=development
