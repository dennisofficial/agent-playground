{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "webpack": false,
    "tsConfigPath": "tsconfig.build.json"
  },
  "monorepo": true,
  "root": "src/atlas",
  "projects": {
    "atlas": {
      "type": "application",
      "root": "src/atlas",
      "entryFile": "atlas-main",
      "sourceRoot": "src",
      "compilerOptions": {
        "tsConfigPath": "src/atlas/tsconfig.json"
      }
    }
  }
}
