{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "webpack": false,
    "tsConfigPath": "tsconfig.build.json"
  },
  "monorepo": true,
  "projects": {
    "slack-app": {
      "type": "application",
      "root": "src/slack-app",
      "entryFile": "slack-app/main",
      "sourceRoot": "src/slack-app",
      "compilerOptions": {
        "tsConfigPath": "src/slack-app/tsconfig.json"
      }
    },
    "daemon": {
      "type": "application",
      "root": "src/daemon",
      "entryFile": "daemon/main",
      "sourceRoot": "src/daemon",
      "compilerOptions": {
        "tsConfigPath": "src/daemon/tsconfig.json"
      }
    }
  }
}
