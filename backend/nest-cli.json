{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "webpack": false,
    "tsConfigPath": "tsconfig.build.json"
  },
  "monorepo": true,
  "root": "src/app",
  "projects": {
    "app": {
      "type": "application",
      "root": "src/app",
      "entryFile": "app/main",
      "sourceRoot": "src/app",
      "compilerOptions": {
        "tsConfigPath": "src/app/tsconfig.json"
      }
    },
    "engine": {
      "type": "application",
      "root": "src/engine",
      "entryFile": "main",
      "sourceRoot": "src",
      "compilerOptions": {
        "tsConfigPath": "src/engine/tsconfig.json",
        "webpack": true,
        "webpackConfigPath": "webpack.engine.config.js"
      }
    }
  }
}
