#!/usr/bin/env bash
# atlas-tx — a shell-composable, READ-ONLY reader for Claude JSONL transcripts written by the various
# lanes (brain/build/plan-review/autofix/review) of this sandbox. It never creates or modifies anything
# under the transcript root; it only finds, cats, filters and greps existing files. Sibling to atlas-svc.
#
# Transcript layout (container side):
#   $TX_ROOT/<orgId>/<repoId>/<jobId>/<type>/[<subId>/]claude/projects/<cwd-slug>/<sessionId>.jsonl
# A sandbox holds exactly one org/repo/job, so every subcommand resolves a session id by searching the
# whole tree rather than taking ids as arguments.
set -uo pipefail

TX_ROOT="${ATLAS_AGENT_HOME:-/.atlas}"

usage() {
  echo "usage: atlas-tx sessions [--lane <type>]" >&2
  echo "       atlas-tx path <sessionId>" >&2
  echo "       atlas-tx cat <sessionId>" >&2
  echo "       atlas-tx show <sessionId> [--role assistant|user] [--thinking] [--text] [--tools] [--errors]" >&2
  echo "                                 [--tail N] [--since <ISO-8601>]" >&2
  echo "       atlas-tx grep <pattern> [--session <sessionId>] [--lane <type>]" >&2
  echo "" >&2
  echo "  sessions   list transcripts under \$ATLAS_AGENT_HOME (default /.atlas), newest first" >&2
  echo "  path       print the resolved absolute path of a session's .jsonl" >&2
  echo "  cat        dump the raw JSONL for a session" >&2
  echo "  show       readable one-line-per-record rendering (default: assistant text blocks)" >&2
  echo "             --tail defaults to 80; --since compares ISO-8601 timestamps as strings" >&2
  echo "  grep       ripgrep a pattern across resolved transcript(s); prints lane:session:<line>" >&2
}

# Guard against path/glob injection before a session id is ever interpolated into find/paths.
valid_sid() { # <sessionId>
  local sid="$1"
  if ! [[ "$sid" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    echo "atlas-tx: invalid session id '$sid'" >&2
    return 2
  fi
}

resolve_session() {  # <sessionId> -> prints .jsonl path or nothing
  local sid="$1"
  find "$TX_ROOT" -type f -path "*/claude/projects/*/${sid}.jsonl" 2>/dev/null | head -n1
}

# Lane label = the 1-2 path segments between <jobId> and /claude/ (e.g. "build", "autofix/x1").
lane_of() { # <path>
  local path="$1"
  local pre b1 pre2 b2
  pre="${path%%/claude/*}"
  b1="${pre##*/}"
  pre2="${pre%/*}"
  b2="${pre2##*/}"
  if [[ "$b2" =~ ^(brain|build|plan-review|autofix|review)$ ]]; then
    printf '%s/%s\n' "$b2" "$b1"
  else
    printf '%s\n' "$b1"
  fi
}

cmd_sessions() {
  local lane_filter=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --lane) lane_filter="${2:-}"; shift 2 ;;
      *) echo "atlas-tx sessions: unknown arg '$1'" >&2; usage; return 2 ;;
    esac
  done

  local rows="" f
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    local sid lane mtime lines
    sid="$(basename "$f" .jsonl)"
    lane="$(lane_of "$f")"
    if [ -n "$lane_filter" ] && [[ "$lane" != "$lane_filter"* ]]; then
      continue
    fi
    mtime="$(stat -c %Y "$f" 2>/dev/null)"
    lines="$(wc -l < "$f" 2>/dev/null)"
    rows="${rows}${mtime:-0}|${sid}|${lane}|${lines:-0}"$'\n'
  done < <(find "$TX_ROOT" -type f -path '*/claude/projects/*.jsonl' 2>/dev/null)

  if [ -z "$rows" ]; then
    echo "(no transcripts found under $TX_ROOT)"
    return 0
  fi

  printf '%-24s %-16s %-20s %8s\n' "SESSION" "LANE" "MTIME" "LINES"
  local sorted
  sorted="$(printf '%s' "$rows" | sort -t'|' -k1,1nr)"
  local mtime sid lane lines human
  while IFS='|' read -r mtime sid lane lines; do
    [ -n "$sid" ] || continue
    human="$(date -d "@$mtime" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)"
    printf '%-24s %-16s %-20s %8s\n' "$sid" "$lane" "${human:-$mtime}" "$lines"
  done <<< "$sorted"
}

cmd_path() {
  local sid="${1:-}"
  if [ -z "$sid" ]; then usage; return 2; fi
  valid_sid "$sid" || return 2
  local f
  f="$(resolve_session "$sid")"
  if [ -z "$f" ]; then
    echo "atlas-tx: no transcript found for session '$sid'" >&2
    return 1
  fi
  echo "$f"
}

cmd_cat() {
  local sid="${1:-}"
  if [ -z "$sid" ]; then usage; return 2; fi
  valid_sid "$sid" || return 2
  local f
  f="$(resolve_session "$sid")"
  if [ -z "$f" ]; then
    echo "atlas-tx: no transcript found for session '$sid'" >&2
    return 1
  fi
  cat "$f"
}

cmd_show() {
  local sid="${1:-}"
  if [ -z "$sid" ]; then usage; return 2; fi
  shift
  valid_sid "$sid" || return 2

  local role="" since="" tail_n=80
  local want_thinking=false want_text=false want_tools=false want_errors=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --role) role="${2:-}"; shift 2 ;;
      --thinking) want_thinking=true; shift ;;
      --text) want_text=true; shift ;;
      --tools) want_tools=true; shift ;;
      --errors) want_errors=true; shift ;;
      --tail) tail_n="${2:-80}"; shift 2 ;;
      --since) since="${2:-}"; shift 2 ;;
      *) echo "atlas-tx show: unknown flag '$1'" >&2; usage; return 2 ;;
    esac
  done

  if ! [[ "$tail_n" =~ ^[0-9]+$ ]]; then
    echo "atlas-tx show: --tail expects a non-negative integer" >&2
    return 2
  fi

  if [ "$want_thinking" = false ] && [ "$want_text" = false ] && [ "$want_tools" = false ] && [ "$want_errors" = false ]; then
    want_text=true
  fi

  local f
  f="$(resolve_session "$sid")"
  if [ -z "$f" ]; then
    echo "atlas-tx: no transcript found for session '$sid'" >&2
    return 1
  fi

  local prog
  # shellcheck disable=SC2016 # deliberately single-quoted: the $-names below are jq's own --arg/--argjson
  # bindings, not shell variables, and must reach jq unexpanded.
  prog='
    def compact: gsub("[\n\r\t]+"; " ") | gsub(" +"; " ");
    def render(role; ts; kind; body):
      "[" + (ts // "") + "] " + role + "/" + kind + ": " + (body | tostring | compact);

    select($roleFilter == "" or .type == $roleFilter)
    | select($since == "" or ((.timestamp // "") >= $since))
    | . as $rec
    | ($rec.timestamp // "") as $ts
    | ($rec.type // "") as $recRole
    | (
        if ($rec.message.content | type) == "array" then $rec.message.content
        elif ($rec.message.content | type) == "string" then [{type: "text", text: $rec.message.content}]
        else []
        end
      )[]
    | . as $block
    | if $block.type == "text" and $wantText then
        render($recRole; $ts; "text"; $block.text)
      elif $block.type == "thinking" and $wantThinking then
        render($recRole; $ts; "thinking"; $block.thinking)
      elif $block.type == "tool_use" and $wantTools then
        render($recRole; $ts; "tool_use"; ($block.name + " " + ($block.input | tojson)))
      elif $block.type == "tool_result" and $wantErrors and ($block.is_error == true) then
        render($recRole; $ts; "tool_result[error]"; (
          ($block.tool_use_id // "") + " " +
          (
            if ($block.content | type) == "array" then
              ($block.content | map(.text // (. | tostring)) | join(" "))
            elif ($block.content | type) == "string" then
              $block.content
            else
              ($block.content | tostring)
            end
          )
        ))
      else empty
      end
  '

  jq -r \
    --arg roleFilter "$role" \
    --arg since "$since" \
    --argjson wantThinking "$want_thinking" \
    --argjson wantText "$want_text" \
    --argjson wantTools "$want_tools" \
    --argjson wantErrors "$want_errors" \
    "$prog" "$f" | tail -n "$tail_n"
}

cmd_grep() {
  local pattern="${1:-}"
  if [ -z "$pattern" ]; then usage; return 2; fi
  shift

  local session_filter="" lane_filter=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --session) session_filter="${2:-}"; shift 2 ;;
      --lane) lane_filter="${2:-}"; shift 2 ;;
      *) echo "atlas-tx grep: unknown flag '$1'" >&2; usage; return 2 ;;
    esac
  done

  local files
  if [ -n "$session_filter" ]; then
    valid_sid "$session_filter" || return 2
    local sf
    sf="$(resolve_session "$session_filter")"
    if [ -z "$sf" ]; then
      echo "atlas-tx: no transcript found for session '$session_filter'" >&2
      return 1
    fi
    files="$sf"
  else
    files="$(find "$TX_ROOT" -type f -path '*/claude/projects/*.jsonl' 2>/dev/null)"
  fi

  local found=0 file
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    local lane sid
    lane="$(lane_of "$file")"
    if [ -n "$lane_filter" ] && [[ "$lane" != "$lane_filter"* ]]; then
      continue
    fi
    sid="$(basename "$file" .jsonl)"
    local matched_line
    while IFS= read -r matched_line; do
      [ -n "$matched_line" ] || continue
      printf '%s:%s:%s\n' "$lane" "$sid" "$matched_line"
      found=1
    done < <(rg --no-heading --no-filename -- "$pattern" "$file" 2>/dev/null)
  done <<< "$files"

  if [ "$found" = 0 ]; then
    echo "(no matches)" >&2
    return 1
  fi
}

case "${1:-}" in
  sessions) shift; cmd_sessions "$@" ;;
  path)     shift; cmd_path "$@" ;;
  cat)      shift; cmd_cat "$@" ;;
  show)     shift; cmd_show "$@" ;;
  grep)     shift; cmd_grep "$@" ;;
  ""|-h|--help) usage ;;
  *) echo "atlas-tx: unknown subcommand '$1'" >&2; usage; exit 2 ;;
esac
