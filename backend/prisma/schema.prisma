model OrganizationMember {
  createdAt  DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @map("updated_at") @default(now()) @db.Timestamptz(6)
  orgId  String @map("org_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid
  role  EOrgRole @default(member)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_organization_members_org_id_organizations")
  user  User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_organization_members_user_id_users")

  @@id([orgId, userId], map: "pk_organization_members")
  @@index([userId], map: "idx_organization_members_user_id")

  @@map("organization_members")
}

model Organization {
  createdAt  DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @map("updated_at") @default(now()) @db.Timestamptz(6)
  id  String @id(map: "pk_organizations") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name  String
  status  EOrgStatus @default(onboarding)
  defaultAutoApprove  Boolean @map("default_auto_approve") @default(false)
  defaultAutoShip  Boolean @map("default_auto_ship") @default(false)
  defaultAutoMerge  Boolean @map("default_auto_merge") @default(false)
  agentCredentials  AgentCredential[]
  inboundMessages  InboundMessage[]
  jobs  Job[]
  orgCredentials  OrgCredential?
  organizationMembers  OrganizationMember[]
  repos  Repo[]
  subagents  Subagent[]
  tasks  Task[]
  threadGroups  ThreadGroup[]
  threadMessages  ThreadMessage[]
  threads  Thread[]
  @@map("organizations")
}

model Repo {
  createdAt  DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @map("updated_at") @default(now()) @db.Timestamptz(6)
  id  String @id(map: "pk_repos") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId  String @map("org_id") @db.Uuid
  slug  String
  name  String
  gitUrl  String @map("git_url")
  defaultBranch  String @map("default_branch") @default("main")
  branchPrefix  String? @map("branch_prefix")
  defaultAutoMergeMethod  EAutoMergeMethod @map("default_auto_merge_method") @default(squash)
  defaultAutoMergeDeleteBranch  Boolean @map("default_auto_merge_delete_branch") @default(true)
  accessOk  Boolean @map("access_ok") @default(false)
  accessCheckedAt  DateTime? @map("access_checked_at") @db.Timestamptz(6)
  webhookWarning  String? @map("webhook_warning")
  onboardingThreadId  String? @map("onboarding_thread_id") @db.Uuid
  onboardedAt  DateTime? @map("onboarded_at") @db.Timestamptz(6)
  threadCount  Int @map("thread_count") @default(0)
  jobs  Job[]
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_repos_org_id_organizations")
  workspaceMounts  WorkspaceMount[]
  workspaceProfiles  WorkspaceProfile?
  workspaceSecretFiles  WorkspaceSecretFile[]

  @@unique([orgId, slug], map: "idx_repos_org_id_slug")
  @@index([orgId], map: "idx_repos_org_id")

  @@map("repos")
}

model Skill {
  createdAt  DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @map("updated_at") @default(now()) @db.Timestamptz(6)
  id  String @id(map: "pk_skills") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId  String @map("org_id") @db.Uuid
  repoId  String? @map("repo_id") @db.Uuid
  name  String
  description  String?
  enabled  Boolean @default(true)

  @@index([orgId], map: "idx_skills_org_id")

  @@map("skills")
}

model Subagent {
  createdAt  DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @map("updated_at") @default(now()) @db.Timestamptz(6)
  id  String @id(map: "pk_subagents") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  threadId  String @map("thread_id") @db.Uuid
  orgId  String @map("org_id") @db.Uuid
  parentMessageId  String @map("parent_message_id") @db.Uuid
  toolUseId  String @map("tool_use_id")
  agentType  String? @map("agent_type")
  model  String?
  status  ESubagentStatus @default(running)
  sessionRef  String? @map("session_ref")
  inputTokens  Int @map("input_tokens") @default(0)
  outputTokens  Int @map("output_tokens") @default(0)
  cacheReadTokens  Int @map("cache_read_tokens") @default(0)
  cacheWriteTokens  Int @map("cache_write_tokens") @default(0)
  costUsd  Float? @map("cost_usd")
  startedAt  DateTime? @map("started_at") @db.Timestamptz(6)
  endedAt  DateTime? @map("ended_at") @db.Timestamptz(6)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_subagents_org_id_organizations")
  parentMessage  ThreadMessage @relation("SubagentParentMessage", fields: [parentMessageId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_subagents_parent_message_id_thread_messages")
  thread  Thread @relation(fields: [threadId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_subagents_thread_id_threads")
  messages  ThreadMessage[] @relation("ThreadMessageSubagent")

  @@index([orgId], map: "idx_subagents_org_id")
  @@index([parentMessageId], map: "idx_subagents_parent_message_id")
  @@index([threadId], map: "idx_subagents_thread_id")
  @@index([toolUseId], map: "idx_subagents_tool_use_id")

  @@map("subagents")
}

model Task {
  createdAt  DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @map("updated_at") @default(now()) @db.Timestamptz(6)
  id  String @id(map: "pk_tasks") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  jobId  String @map("job_id") @db.Uuid
  threadGroupId  String @map("thread_group_id") @db.Uuid
  orgId  String @map("org_id") @db.Uuid
  ordinal  Int
  title  String
  brief  String?
  activeForm  String? @map("active_form")
  status  ETaskStatus @default(pending)
  blockedBy  Json @map("blocked_by") @default("[]")
  job  Job @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tasks_job_id_jobs")
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tasks_org_id_organizations")
  threadGroup  ThreadGroup @relation(fields: [threadGroupId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tasks_thread_group_id_thread_groups")

  @@index([jobId], map: "idx_tasks_job_id")
  @@index([orgId], map: "idx_tasks_org_id")
  @@index([threadGroupId], map: "idx_tasks_thread_group_id")
  @@index([threadGroupId, ordinal], map: "idx_tasks_thread_group_id_ordinal")

  @@map("tasks")
}

model ThreadGroup {
  createdAt  DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @map("updated_at") @default(now()) @db.Timestamptz(6)
  id  String @id(map: "pk_thread_groups") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
