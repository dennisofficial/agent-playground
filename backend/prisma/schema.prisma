  orgId  String @map("org_id") @id(map: "pk_org_credentials") @db.Uuid
  anthropicApiKeyEnc  String? @map("anthropic_api_key_enc")
  openaiApiKeyEnc  String? @map("openai_api_key_enc")
  githubPatEnc  String? @map("github_pat_enc")
