  orgId  String @map("org_id") @db.Uuid
  ordinal  Int
  kind  EThreadGroupKind
  title  String?
  type  String?
  status  EThreadGroupStatus @default(pending)
  condition  EThreadGroupCondition @default(none)
  tasks  Task[]
  job  Job @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_thread_groups_job_id_jobs")
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_thread_groups_org_id_organizations")
  threads  Thread[]
  @@index([jobId], map: "idx_thread_groups_job_id")
  @@index([jobId, ordinal], map: "idx_thread_groups_job_id_ordinal")
  @@index([orgId], map: "idx_thread_groups_org_id")

  @@map("thread_groups")
}

model ThreadMessage {
  createdAt  DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @map("updated_at") @default(now()) @db.Timestamptz(6)
  id  String @id(map: "pk_thread_messages") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  jobId  String @map("job_id") @db.Uuid
  threadId  String @map("thread_id") @db.Uuid
  orgId  String @map("org_id") @db.Uuid
  subagentId  String? @map("subagent_id") @db.Uuid
  source  EThreadMessageSource
  authorId  String @map("author_id")
  text  String
  card  Json?
  meta  Json?
  orderAt  DateTime? @map("order_at") @db.Timestamptz(6)
  audience  EMessageAudience @default(shared)
  type  EThreadMessageType @default(chat)
  spawnedSubagents  Subagent[] @relation("SubagentParentMessage")
  job  Job @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_thread_messages_job_id_jobs")
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_thread_messages_org_id_organizations")
  subagent  Subagent? @relation("ThreadMessageSubagent", fields: [subagentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_thread_messages_subagent_id_subagents")
  thread  Thread @relation(fields: [threadId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_thread_messages_thread_id_threads")

  @@index([jobId, createdAt], map: "idx_thread_messages_job_id_created_at")
  @@index([orgId], map: "idx_thread_messages_org_id")
  @@index([subagentId], map: "idx_thread_messages_subagent_id")
  @@index([threadId, createdAt], map: "idx_thread_messages_thread_id_created_at")

  @@map("thread_messages")
}

model Thread {
  createdAt  DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @map("updated_at") @default(now()) @db.Timestamptz(6)
  id  String @id(map: "pk_threads") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  jobId  String @map("job_id") @db.Uuid
  threadGroupId  String @map("thread_group_id") @db.Uuid
  orgId  String @map("org_id") @db.Uuid
  parentThreadId  String? @map("parent_thread_id") @db.Uuid
  role  EThreadRole
  type  EThreadType @default(general)
  ordinal  Int
  brief  String
  status  EThreadStatus @default(pending)
  condition  EThreadCondition @default(none)
  sessionId  String? @map("session_id")
  inboundMessages  InboundMessage[]
  focusedByJobs  Job[] @relation("JobFocusedThread")
  subagents  Subagent[]
  threadMessages  ThreadMessage[]
  job  Job @relation("ThreadJob", fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_threads_job_id_jobs")
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_threads_org_id_organizations")
  parentThread  Thread? @relation("ThreadParent", fields: [parentThreadId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_threads_parent_thread_id_threads")
  childThreads  Thread[] @relation("ThreadParent")
  threadGroup  ThreadGroup @relation(fields: [threadGroupId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_threads_thread_group_id_thread_groups")

  @@index([jobId], map: "idx_threads_job_id")
  @@index([orgId], map: "idx_threads_org_id")
  @@index([parentThreadId], map: "idx_threads_parent_thread_id")
  @@index([threadGroupId], map: "idx_threads_thread_group_id")

  @@map("threads")
}

