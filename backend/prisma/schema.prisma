generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

generator pgbase {
  provider        = "pgbase"
  output          = "../src/generated/pgbase"
  previewFeatures = ["partialIndexes"]
}

// The same artifact again, into shared/, because the browser needs the row types to type the pgbase
// client and cannot reach the backend's gitignored build output. Emitted rather than hand-mirrored:
// both copies come from one `prisma generate` over one schema, so they cannot drift. Only the
// types-only `models.ts` half is exported to consumers — see shared's `./pgbase` subpath.
generator pgbaseClient {
  provider        = "pgbase"
  output          = "../../shared/src/generated/pgbase"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model AgentCredential {
  createdAt  DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @map("updated_at") @default(now()) @db.Timestamptz(6)
  id  String @id(map: "pk_agent_credentials") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId  String @map("org_id") @db.Uuid
  provider  EAgentProvider
  kind  EAgentCredentialKind
  label  String
  accountEmail  String? @map("account_email")
  subscriptionType  String? @map("subscription_type")
  status  EAgentCredentialStatus @default(active)
  scopes  String?
  materialEnc  String @map("material_enc")
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  lastRefreshedAt  DateTime? @map("last_refreshed_at") @db.Timestamptz(6)
  selected  Boolean @default(false)
  usageSnapshot  Json? @map("usage_snapshot")
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_agent_credentials_org_id_organizations")

  @@unique([orgId, provider], map: "idx_agent_credentials_org_id_provider", where: raw("selected"))
  @@unique([orgId, provider, accountEmail], map: "idx_agent_credentials_org_id_provider_account_email", where: raw("((kind = 'personal'::EAgentCredentialKind) AND (account_email IS NOT NULL))"))
  @@index([orgId], map: "idx_agent_credentials_org_id")

  @@map("agent_credentials")
}

model InboundMessage {
  createdAt  DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @map("updated_at") @default(now()) @db.Timestamptz(6)
  id  String @id(map: "pk_inbound_messages") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId  String @map("org_id") @db.Uuid
  jobId  String @map("job_id") @db.Uuid
  threadId  String @map("thread_id") @db.Uuid
  authorId  String @map("author_id")
  source  EInboundMessageSource
  text  String
  payload  Json?
  status  EInboundMessageStatus @default(pending)
  priority  EInboundPriority @default(now)
  deliveredAt  DateTime? @map("delivered_at") @db.Timestamptz(6)
  job  Job @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inbound_messages_job_id_jobs")
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inbound_messages_org_id_organizations")
  thread  Thread @relation(fields: [threadId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inbound_messages_thread_id_threads")

  @@index([jobId, status], map: "idx_inbound_messages_job_id_status")
  @@index([orgId], map: "idx_inbound_messages_org_id")

  @@map("inbound_messages")
}

model Job {
  createdAt  DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @map("updated_at") @default(now()) @db.Timestamptz(6)
  id  String @id(map: "pk_jobs") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId  String @map("org_id") @db.Uuid
  repoId  String @map("repo_id") @db.Uuid
  focusedThreadId  String? @map("focused_thread_id") @db.Uuid
  title  String?
  origin  EJobOrigin @default(chat)
  kind  EJobKind?
  status  EJobStatus @default(open)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)
  inboundMessages  InboundMessage[]
  focusedThread  Thread? @relation("JobFocusedThread", fields: [focusedThreadId], references: [id], onUpdate: NoAction, map: "fk_jobs_focused_thread_id_threads")
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_jobs_org_id_organizations")
  repo  Repo @relation(fields: [repoId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_jobs_repo_id_repos")
  tasks  Task[]
  threadGroups  ThreadGroup[]
  threadMessages  ThreadMessage[]
  threads  Thread[] @relation("ThreadJob")

  @@index([orgId, repoId], map: "idx_jobs_org_id_repo_id")

  @@map("jobs")
}

model McpServer {
  createdAt  DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @map("updated_at") @default(now()) @db.Timestamptz(6)
  id  String @id(map: "pk_mcp_servers") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId  String @map("org_id") @db.Uuid
  repoId  String? @map("repo_id") @db.Uuid
  name  String
  enabled  Boolean @default(true)

  @@index([orgId], map: "idx_mcp_servers_org_id")

  @@map("mcp_servers")
}

