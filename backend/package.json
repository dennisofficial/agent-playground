{
  "name": "backend",
  "version": "0.0.1",
  "description": "Atlas v2 orchestrator backend (NestJS).",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "env:inject": "dotenvx run -f .env.local.enc -f .env.personal --ignore=MISSING_ENV_FILE -o --strict",
    "dev:env": "cross-env NODE_ENV=development NODE_OPTIONS=--enable-source-maps pnpm env:inject",
    "build": "nest build host",
    "build:engine": "nest build engine --webpack --webpackPath webpack.engine.config.js",
    "build:engine:watch": "nest build engine --webpack --webpackPath webpack.engine.config.js --watch",
    "dev-cluster:up": "pnpm env:inject -- bash scripts/dev-cluster-up.sh",
    "dev-cluster:down": "bash scripts/dev-cluster-down.sh",
    "sandbox:build": "pnpm env:inject -- bash scripts/build-and-push.sh",
    "engine:sync": "pnpm env:inject -- bash scripts/engine-sync.sh",
    "dev": "pnpm dev:env -- nest start host --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "typecheck:cli": "tsc --noEmit -p tsconfig.cli.json",
    "format": "prettier --write .",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --mode unit",
    "test:int": "vitest run --mode int",
    "test:e2e": "vitest run --mode e2e",
    "test:ai": "vitest run --mode ai --reporter=verbose --passWithNoTests",
    "eval": "ai-eval",
    "eval:check": "ai-eval --check",
    "test:cov": "vitest run --coverage",
    "prisma": "pnpm env:inject -- prisma",
    "db:generate": "pnpm env:inject -- prisma generate",
    "db:pull": "pnpm env:inject -- prisma db pull",
    "db:seed": "dotenvx run -f .env.local.enc -f .env.seed.enc -f .env.personal --ignore=MISSING_ENV_FILE -o --strict -- cross-env NODE_ENV=development TS_NODE_PROJECT=tsconfig.cli.json ts-node --project tsconfig.cli.json cli/seed-runner.ts",
    "db:recreate": "pnpm db:migrate:reset --force --skip-seed && pnpm db:seed",
    "db:migrate": "pnpm env:inject -- prisma migrate dev",
    "db:migrate:deploy": "pnpm env:inject -- prisma migrate deploy",
    "db:migrate:reset": "pnpm env:inject -- prisma migrate reset"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.204",
    "@dltech/jwt-auth": "^1.0.0",
    "@dltech/nestjs-core": "^1.0.1",
    "@dltech/nestjs-langfuse": "^1.0.0",
    "@dltech/pgbase": "^1.0.0",
    "@dotenvx/dotenvx": "^1.71.0",
    "@kubernetes/client-node": "^1.4.0",
    "@langchain/anthropic": "^1.5.1",
    "@langchain/core": "1.1.48",
    "@langchain/langgraph": "^1.3.6",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.0",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.4.7",
    "@langfuse/client": "^5.4.1",
    "@langfuse/core": "^5.4.1",
    "@langfuse/otel": "^5.4.1",
    "@langfuse/tracing": "^5.4.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^4.0.0",
    "@node-rs/argon2": "^2.0.2",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/plugin-retry": "^8.1.0",
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/request-error": "^7.1.0",
    "@octokit/rest": "^22.0.1",
    "@openai/codex": "0.137.0",
    "@openai/codex-sdk": "^0.137.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@types/cookie-parser": "^1.4.10",
    "@workspace/agent-engine": "workspace:*",
    "@workspace/codex-sdk": "workspace:*",
    "@workspace/shared": "workspace:*",
    "async-sema": "^3.1.1",
    "axios": "^1.15.2",
    "bullmq": "^5.34.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "diff": "^9.0.0",
    "dockerode": "^4.0.1",
    "esbuild": "^0.28.1",
    "ioredis": "^5.11.1",
    "joi": "^17.13.3",
    "langchain": "^1.4.4",
    "mongoose": "^9.6.3",
    "pg": "^8.13.1",
    "pgvector": "^0.3.0",
    "picomatch": "^4.0.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dltech/ai-testing": "^1.0.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.10.0",
    "@types/dockerode": "^3.3.23",
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.20",
    "@types/pg": "^8.11.10",
    "@types/picomatch": "^4.0.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prisma": "7.9.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.0.0",
    "webpack": "^5.106.2"
  }
}
