{
  "name": "backend",
  "version": "0.0.1",
  "description": "AI-employee harness backend (NestJS monorepo: api + tui apps).",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "env:inject": "dotenvx run -f .env.local.enc -f .env.personal --ignore=MISSING_ENV_FILE -o --strict",
    "dev:env": "cross-env NODE_ENV=development NODE_OPTIONS=--enable-source-maps pnpm env:inject",
    "build": "nest build api && nest build tui && nest build slack-app",
    "api:dev": "pnpm dev:env -- nest start api --watch",
    "api:prod": "node dist/api/main",
    "tui:dev": "pnpm dev:env -- nest start tui",
    "slack:dev": "pnpm dev:env -- nest start slack-app",
    "slack:prod": "node dist/slack-app/main",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --mode unit",
    "test:e2e": "vitest run --mode e2e",
    "test:ai": "vitest run --mode ai --reporter=verbose --passWithNoTests",
    "test:cov": "vitest run --coverage",
    "db:migrate": "pnpm env:inject -- cross-env TS_NODE_PROJECT=tsconfig.cli.json typeorm-ts-node-commonjs migration:run -d cli/data-source.ts",
    "db:migrate:revert": "pnpm env:inject -- cross-env TS_NODE_PROJECT=tsconfig.cli.json typeorm-ts-node-commonjs migration:revert -d cli/data-source.ts",
    "db:migration:generate": "pnpm env:inject -- ts-node --project tsconfig.cli.json cli/migration-generate.ts",
    "db:migration:create": "ts-node --project tsconfig.cli.json cli/migration-create.ts",
    "db:schema:drop": "pnpm env:inject -- cross-env TS_NODE_PROJECT=tsconfig.cli.json typeorm-ts-node-commonjs schema:drop -d cli/data-source.ts",
    "db:seed": "cross-env NODE_ENV=development pnpm env:inject -- ts-node --project tsconfig.cli.json cli/seed-runner.ts",
    "db:recreate": "pnpm run db:schema:drop && pnpm run db:migrate && pnpm run db:seed",
    "puppet:register": "pnpm env:inject -- ts-node --project tsconfig.cli.json cli/register-puppet-token.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.168",
    "@inkjs/ui": "^2.0.0",
    "@langchain/anthropic": "^1.4.0",
    "@langchain/core": "1.1.48",
    "@langchain/langgraph": "^1.3.6",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.0",
    "@langchain/openai": "^1.4.7",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.1",
    "@node-rs/argon2": "^2.0.2",
    "@openai/codex-sdk": "^0.137.0",
    "@slack/socket-mode": "^2.0.7",
    "@slack/web-api": "^7.16.0",
    "@types/cookie-parser": "^1.4.10",
    "@workspace/auth": "workspace:*",
    "@workspace/nestjs-core": "workspace:^",
    "@workspace/shared": "workspace:*",
    "bullmq": "^5.34.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "ink": "^7.0.5",
    "joi": "^17.13.3",
    "langchain": "^1.4.4",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "mongoose": "^9.6.3",
    "pg": "^8.13.1",
    "pgvector": "^0.3.0",
    "react": "^19.2.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.30",
    "typeorm-naming-strategies": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.71.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.10.0",
    "@types/express": "^5.0.0",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.17",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.0.0"
  }
}
