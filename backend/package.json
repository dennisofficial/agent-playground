{
  "name": "backend",
  "version": "0.0.1",
  "description": "Atlas v2 orchestrator backend (NestJS).",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "env:inject": "dotenvx run -f .env.local.enc -f .env.personal --ignore=MISSING_ENV_FILE -o --strict",
    "dev:env": "cross-env NODE_ENV=development NODE_OPTIONS=--enable-source-maps pnpm env:inject",
    "build": "nest build app",
    "build:engine": "nest build engine --webpack --webpackPath webpack.engine.config.js",
    "build:engine:watch": "nest build engine --webpack --webpackPath webpack.engine.config.js --watch",
    "dev": "pnpm dev:env -- nest start app --watch",
    "start:prod": "node dist/main",
    "e2e": "pnpm dev:env -- cross-env TS_NODE_PROJECT=tsconfig.e2e.json node -r tsconfig-paths/register -r ts-node/register src/app/e2e/e2e-main.ts",
    "reap": "cross-env TS_NODE_PROJECT=tsconfig.cli.json node -r ts-node/register cli/reap-sandboxes.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:cli": "tsc --noEmit -p tsconfig.cli.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --mode unit",
    "test:int": "vitest run --mode int",
    "test:e2e": "vitest run --mode e2e",
    "test:ai": "vitest run --mode ai --reporter=verbose --passWithNoTests",
    "eval": "ai-eval",
    "eval:check": "ai-eval --check",
    "test:cov": "vitest run --coverage",
    "db:migrate": "pnpm env:inject -- cross-env TS_NODE_PROJECT=tsconfig.cli.json typeorm-ts-node-commonjs migration:run -d cli/data-source.ts",
    "db:migrate:deploy": "cross-env TS_NODE_PROJECT=tsconfig.cli.json typeorm-ts-node-commonjs migration:run -d cli/data-source.ts",
    "db:migrate:revert": "pnpm env:inject -- cross-env TS_NODE_PROJECT=tsconfig.cli.json typeorm-ts-node-commonjs migration:revert -d cli/data-source.ts",
    "db:migration:generate": "pnpm env:inject -- ts-node --project tsconfig.cli.json cli/migration-generate.ts",
    "db:migration:check": "git fetch --no-tags origin main:refs/remotes/origin/main && vitest run --mode unit migrations-hygiene",
    "db:schema:drop": "pnpm env:inject -- cross-env TS_NODE_PROJECT=tsconfig.cli.json typeorm-ts-node-commonjs schema:drop -d cli/data-source.ts",
    "db:seed": "dotenvx run -f .env.local.enc -f .env.seed.enc -f .env.personal --ignore=MISSING_ENV_FILE -o --strict -- cross-env NODE_ENV=development ts-node --project tsconfig.cli.json cli/seed-runner.ts",
    "db:recover-turn": "pnpm env:inject -- ts-node --project tsconfig.cli.json cli/recover-turn.ts",
    "db:recreate": "pnpm db:schema:drop && pnpm db:migrate && pnpm db:seed",
    "seed:demo": "pnpm env:inject -- cross-env TS_NODE_PROJECT=tsconfig.cli.json ts-node --project tsconfig.cli.json scripts/seed-demo-jobs.ts",
    "seed:scroll-fixture": "pnpm seed:demo && pnpm env:inject -- cross-env TS_NODE_PROJECT=tsconfig.cli.json ts-node --project tsconfig.cli.json scripts/load-scroll-fixture.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.204",
    "@dotenvx/dotenvx": "^1.71.0",
    "@langchain/anthropic": "^1.5.1",
    "@langchain/core": "1.1.48",
    "@langchain/langgraph": "^1.3.6",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.0",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.4.7",
    "@langfuse/client": "^5.4.1",
    "@langfuse/core": "^5.4.1",
    "@langfuse/otel": "^5.4.1",
    "@langfuse/tracing": "^5.4.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/typeorm": "^11.0.1",
    "@node-rs/argon2": "^2.0.2",
    "@openai/codex": "0.137.0",
    "@openai/codex-sdk": "^0.137.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@types/cookie-parser": "^1.4.10",
    "@workspace/agent-engine": "workspace:*",
    "@workspace/auth": "workspace:*",
    "@workspace/codex-sdk": "workspace:*",
    "@workspace/langfuse": "workspace:*",
    "@workspace/nestjs-core": "workspace:^",
    "@workspace/pg-realtime": "workspace:*",
    "@workspace/shared": "workspace:*",
    "async-sema": "^3.1.1",
    "bullmq": "^5.34.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "diff": "^9.0.0",
    "dockerode": "^4.0.1",
    "esbuild": "^0.28.1",
    "ioredis": "^5.11.1",
    "joi": "^17.13.3",
    "langchain": "^1.4.4",
    "mongoose": "^9.6.3",
    "pg": "^8.13.1",
    "pgvector": "^0.3.0",
    "picomatch": "^4.0.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.30",
    "typeorm-naming-strategies": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.10.0",
    "@types/dockerode": "^3.3.23",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/picomatch": "^4.0.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.0.0",
    "@workspace/ai-testing": "workspace:*",
    "cross-env": "^7.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.0.0"
  }
}
