{
  "name": "backend",
  "version": "0.0.1",
  "description": "Atlas v2 orchestrator backend (NestJS).",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "env:inject": "dotenvx run -f .env.local.enc -f .env.personal --ignore=MISSING_ENV_FILE -o --strict",
    "dev:env": "cross-env NODE_ENV=development NODE_OPTIONS=--enable-source-maps pnpm env:inject",
    "build": "nest build atlas",
    "atlas:dev": "pnpm dev:env -- nest start atlas",
    "atlas:prod": "node dist/atlas-main",
    "atlas:gate": "pnpm dev:env -- cross-env TS_NODE_PROJECT=tsconfig.atlas-gate.json node -r tsconfig-paths/register -r ts-node/register src/atlas/gate/gate-main.ts",
    "atlas:e2e": "pnpm dev:env -- cross-env TS_NODE_PROJECT=tsconfig.atlas-e2e.json node -r tsconfig-paths/register -r ts-node/register src/atlas/e2e/e2e-main.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --mode unit",
    "test:e2e": "vitest run --mode e2e",
    "test:ai": "vitest run --mode ai --reporter=verbose --passWithNoTests",
    "test:cov": "vitest run --coverage",
    "db:atlas:migrate": "pnpm env:inject -- cross-env TS_NODE_PROJECT=tsconfig.cli.json typeorm-ts-node-commonjs migration:run -d cli/atlas-data-source.ts",
    "db:atlas:migrate:revert": "pnpm env:inject -- cross-env TS_NODE_PROJECT=tsconfig.cli.json typeorm-ts-node-commonjs migration:revert -d cli/atlas-data-source.ts",
    "db:atlas:migration:generate": "pnpm env:inject -- ts-node --project tsconfig.cli.json cli/atlas-migration-generate.ts",
    "db:atlas:schema:drop": "pnpm env:inject -- cross-env TS_NODE_PROJECT=tsconfig.cli.json typeorm-ts-node-commonjs schema:drop -d cli/atlas-data-source.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.168",
    "@langchain/anthropic": "^1.4.0",
    "@langchain/core": "1.1.48",
    "@langchain/langgraph": "^1.3.6",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.0",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.4.7",
    "@langfuse/client": "^5.4.1",
    "@langfuse/core": "^5.4.1",
    "@langfuse/otel": "^5.4.1",
    "@langfuse/tracing": "^5.4.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/typeorm": "^11.0.1",
    "@node-rs/argon2": "^2.0.2",
    "@openai/codex-sdk": "^0.137.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@slack/socket-mode": "^2.0.7",
    "@slack/web-api": "^7.16.0",
    "@types/cookie-parser": "^1.4.10",
    "@workspace/auth": "workspace:*",
    "@workspace/langfuse": "workspace:*",
    "@workspace/nestjs-core": "workspace:^",
    "@workspace/pg-realtime": "workspace:*",
    "@workspace/shared": "workspace:*",
    "bullmq": "^5.34.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dockerode": "^4.0.1",
    "ioredis": "^5.11.1",
    "joi": "^17.13.3",
    "langchain": "^1.4.4",
    "mongoose": "^9.6.3",
    "pg": "^8.13.1",
    "pgvector": "^0.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.30",
    "typeorm-naming-strategies": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.71.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.10.0",
    "@types/dockerode": "^3.3.23",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.0.0"
  }
}
