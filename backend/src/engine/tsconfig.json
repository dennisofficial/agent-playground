{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "outDir": "../../dist",
    "sourceMap": true,
    "paths": {
      "@engine/*": ["./*"],
      "@core/*": ["../_core/*"],
      "@lib/*": ["../_lib/*"],
      "@shared/*": ["../_shared/*"]
    }
  },
  "include": ["**/*", "../shared/**/*", "../_core/**/*", "../_lib/**/*"],
  "exclude": [
    "../../node_modules",
    "dist",
    "**/*spec.ts",
    "**/*.test.ts",
    "**/*.eval.ts",
    "**/*.ai.data.ts",
    "__e2e__/**"
  ]
}
